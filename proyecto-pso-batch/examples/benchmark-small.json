{
  "name": "benchmark-small",
  "dag": {
    "nodes": [
      {
        "id": "read",
        "op": "read_csv",
        "path": "data/input/small-dataset.csv",
        "partitions": 2
      },
      {
        "id": "filter",
        "op": "filter",
        "fn": "non_empty"
      },
      {
        "id": "lowercase",
        "op": "map",
        "fn": "to_lower"
      }
    ],
    "edges": [["read", "filter"], ["filter", "lowercase"]]
  },
  "parallelism": 2
}
