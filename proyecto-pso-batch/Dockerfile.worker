# ============================================================================
# Dockerfile.worker - Worker Node
# ============================================================================
FROM golang:1.21-alpine AS builder

WORKDIR /build

# Copiar módulos
COPY go.mod go.sum ./
RUN go mod download

# Copiar código
COPY . .

# Compilar worker - RUTA CORREGIDA (sin cmd/)
RUN CGO_ENABLED=0 GOOS=linux go build -o worker ./worker

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM alpine:3.18

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

# Crear directorios
RUN mkdir -p data/input data/output data/spill logs

# Copiar binario
COPY --from=builder /build/worker .

# Copiar datos
COPY data/input data/input

EXPOSE 9001 9002 9003

CMD ["./worker"]