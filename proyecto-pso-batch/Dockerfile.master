# ============================================================================
# Dockerfile.master - Master Node
# ============================================================================
FROM golang:1.21-alpine AS builder

WORKDIR /build

# Copiar módulos
COPY go.mod go.sum ./
RUN go mod download

# Copiar código
COPY . .

# Compilar master - RUTA CORREGIDA (sin cmd/)
RUN CGO_ENABLED=0 GOOS=linux go build -o master ./master

# ============================================================================
# Stage 2: Runtime
# ============================================================================
FROM alpine:3.18

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

# Crear directorios
RUN mkdir -p data/input data/output logs

# Copiar binario
COPY --from=builder /build/master .

# Copiar datos de ejemplo
COPY data/input data/input

EXPOSE 8080

CMD ["./master"]